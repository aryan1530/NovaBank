# Local development only. Change every value before sharing or deploying.
POSTGRES_USER=novabank
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_TOKEN=replace-with-a-long-random-service-token
GRAFANA_ADMIN_PASSWORD=replace-me

# Change if host port 8080 is already in use
API_GATEWAY_HOST_PORT=8080
